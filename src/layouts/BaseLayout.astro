---
import '../styles/global.css';

import { NAVIGATION, SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  pubDate?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  pubDate,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonicalUrl = new URL(canonicalPath, SITE.origin);
const currentPath = Astro.url.pathname;
const currentYear = new Date().getUTCFullYear();

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} RSS feed`}
      href={new URL(SITE.feedPath, SITE.origin)}
    />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {
      pubDate && (
        <meta
          property="article:published_time"
          content={`${pubDate}T00:00:00Z`}
        />
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="site-name" href="/">{SITE.owner}</a>
        <nav aria-label="Primary navigation">
          <ul class="nav-list">
            {
              NAVIGATION.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>Words by {SITE.owner}.</p>
        <p>
          <a href={SITE.feedPath}>RSS</a>
          <span aria-hidden="true"> · </span>
          <a href={SITE.githubUrl} rel="me">GitHub</a>
          <span aria-hidden="true"> · </span>
          <span>{currentYear}</span>
        </p>
      </div>
    </footer>
  </body>
</html>
