{
  "name": "crestendotpizza",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cresten St. Clair's static Markdown blog",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": false,
    "workerd@1.20260722.1": true
  },
  "overrides": {
    "kind-of": "^6.0.3"
  },
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "check": "astro check && npm run validate:content",
    "build": "npm run check && astro build && npm run validate:output",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "new:post": "node scripts/new-post.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:output": "node scripts/validate-output.mjs && node scripts/check-links.mjs",
    "validate:wrangler": "node scripts/validate-wrangler.mjs",
    "validate:deployment": "node scripts/validate-deployment.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run audit && npm test && npm run build && npm run validate:wrangler"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.10.0",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
